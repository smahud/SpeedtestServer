[Unit]
Description=SpeedtestServer HTTP legacy fallback
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=speedtestserver
Group=speedtestserver
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/speedtestserver/dist/bin/legacy-http.js
WorkingDirectory=/var/lib/speedtestserver
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
