{
  "name": "ooklaserver",
  "version": "1.0.0",
  "description": "TypeScript implementation of OoklaServer - Speed Test Server",
  "main": "dist/bin/ooklaserver.js",
  "bin": {
    "ooklaserver": "dist/bin/ooklaserver.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/bin/ooklaserver.js",
    "dev": "ts-node src/bin/ooklaserver.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "speedtest",
    "ookla",
    "server",
    "network",
    "bandwidth"
  ],
  "author": "OoklaServer Reverse Engineering Project",
  "license": "MIT",
  "dependencies": {
    "@types/node": "^20.10.0",
    "@types/node-forge": "^1.3.14",
    "node-forge": "^1.4.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ooklaserver/ooklaserver-ts"
  },
  "bugs": {
    "url": "https://github.com/ooklaserver/ooklaserver-ts/issues"
  }
}
