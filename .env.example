# ============================================================================
# .env — KONFIGURASI FULL-STACK SPEEDTEST HYBRID (v1.5)
# ============================================================================
# File ini adalah SATU-SATUNYA sumber konfigurasi: daemon speedtest, gateway
# hybrid di VPS, dan DEPLOY POOL WORKER CLOUDFLARE (jumlah worker,
# kredensial, secret). Dibaca install.sh saat instalasi DAN diawasi gateway
# saat berjalan — perubahan pada kunci di bawah diterapkan ON-THE-FLY
# (tanpa restart): CF_WORKER_DEPLOY_COUNT, HYBRID_WORKER_*, HYBRID_VPS_DL_SHARE,
# HYBRID_FRONT_*, HYBRID_SESSIONS_RATE_LIMIT_MPM, HYBRID_SHARED_SECRET,
# CLOUDFLARE_* (ganti kredensial = redeploy worker otomatis).
# Yang butuh restart (jalankan ulang install.sh): HYBRID_GATEWAY_PORT/BIND/
# TLS, HYBRID_VPS_PUBLIC_BASE, HYBRID_STS_BASE, HYBRID_RESULTS_FILE.
# Kunci SPEEDTEST_BRIDGE_*: diterapkan via `systemctl restart
# speedtest-bridge` atau jalankan ulang install.sh (tidak di-watch live).
#
# CARA PAKAI:
#   cp .env.example .env      # lalu edit nilai di bawah
#   nano .env                 # isi bagian [WAJIB] minimal
#   sudo ./install.sh --start
#
# PANDUAN LENGKAP KREDENSIAL CLOUDFLARE (token vs global key, permission
# scopes yang tepat, cara mencari Account ID, perintah verifikasi):
#   docs/CLOUDFLARE_CREDENTIALS.md          ← BACA INI sebelum mengisi
#
# KEAMANAN:
#   - .env DIKECUALIKAN dari git (.gitignore) — JANGAN PERNAH commit.
#   - File ini berisi rahasia (API token/global key). chmod 600 .env.
#   - install.sh tidak mengeksekusi isi file ini sebagai shell — hanya
#     membaca baris KEY=VALUE literal (aman dari kode jahat).
#   - Format: KEY=VALUE tanpa spasi di sekeliling tanda =; nilai boleh
#     dibungkus kutip "..."; TIDAK ADA komentar inline di belakang nilai.
# ============================================================================


# ============================================================================
# [WAJIB] KREDENSIAL CLOUDFLARE — untuk deploy worker pool
# ============================================================================
# Pilih SATU dari dua metode autentikasi:
#
# METODE 1 (DIANJURKAN) — API Token dengan scope TERBATAS:
#   Buat di: https://dash.cloudflare.com/profile/api-tokens
#            → "Create Token" → template "Edit Cloudflare Workers"
#   Permission scopes yang HARUS dimiliki token (detail + alasan tiap
#   scope: docs/CLOUDFLARE_CREDENTIALS.md):
#     - Account | Workers Scripts    | Edit   ← deploy/update worker + set secret
#     - Account | Account Settings   | Read   ← resolusi akun oleh wrangler
#     - User    | User Details       | Read   ← wrangler whoami / verifikasi
#   Account Resources: Include → akun yang dipakai.
#   (HANYA jika nanti pakai custom domain/route zone — bukan workers.dev —
#    tambahkan: Zone | Workers Routes | Edit + Zone | Zone | Read.)
#   Nilai contoh: cfut_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_API_TOKEN=

# METODE 2 (ALTERNATIF) — Global API Key (permission PENUH akun, risiko
#   lebih besar; pakai hanya bila token scoped ditolak sistem):
#   Ambil di: https://dash.cloudflare.com/profile/api-tokens
#             → bagian "Global API Key" → View
#   Kedua variabel HARUS terisi berpasangan:
CLOUDFLARE_EMAIL=
CLOUDFLARE_API_KEY=

# [WAJIB] Account ID Cloudflare — 32 karakter hex.
#   Cara cari: dashboard Cloudflare → Workers & Pages → sidebar kanan
#   "Account ID", atau `npx wrangler whoami`, atau
#   curl -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
#     https://api.cloudflare.com/client/v4/accounts
#   Contoh: 5159165037054bd3ddc033e34cefe46e
CLOUDFLARE_ACCOUNT_ID=


# ============================================================================
# [WAJIB] JUMLAH WORKER TARGET (deploy/undeploy on-the-fly)
# ============================================================================
# JUMLAH WORKER TARGET — di-sync ON-THE-FLY: edit nilai ini saat gateway
# sudah berjalan dan pool Cloudflare menyesuaikan dalam hitungan detik
# (deploy worker baru / hapus kelebihan via REST; lihat docs/WORKER_POOL.md).
#   - Rentang valid: 1..100 (batas script per akun Workers Free).
#   - Worker 1 = primary `CF_WORKER_NAME`; worker 2..N = `-2`..`-N`.
#   - Worker IDLE = 0 invocations (tidak membakar kuota 100k req/hari,
#     yang sifatnya PER AKUN dan didistribusikan, bukan dikalikan).
#   - Setiap worker otomatis menerima HYBRID_SHARED_SECRET yang sama.
#   - Gateway VPS menumbuhkan/mengecilkan set AKTIF secara otonom
#     (autoscaler canary-gated) di dalam batas ini.
CF_WORKER_DEPLOY_COUNT=100

# Subdomain workers.dev akun (untuk URL worker: <nama>.<subdomain>.workers.dev).
#   Lihat: dashboard → Workers & Pages → (worker apa pun) → domain-nya,
#   atau `npx wrangler whoami`. Contoh: lumajangnetworks
CF_WORKERS_SUBDOMAIN=lumajangnetworks

# Nama script worker utama (worker 1). Sibling otomatis: <nama>-2..<nama>-N.
CF_WORKER_NAME=speedtest-hybrid-worker

# Verifikasi /__meta tiap worker setelah deploy (1 = ya, 0 = lewati;
# 1 request per worker — murah, biarkan 1).
CF_WORKER_VERIFY=1


# ============================================================================
# [WAJIB] SHARED SECRET — HMAC antara gateway VPS dan semua worker
# ============================================================================
# Sama untuk VPS (gateway.env) dan setiap worker Cloudflare.
# BIARKAN KOSONG → install.sh MEMBUATKAN secara otomatis (openssl rand
# -hex 32), menyimpannya ke file ini, dan mendeploy-nya ke semua worker.
# Atau isi sendiri: minimal 32 karakter acak, mis. `openssl rand -hex 32`.
HYBRID_SHARED_SECRET=


# ============================================================================
# MODE INSTALASI
# ============================================================================
# true  = pasang SEMUA: daemon + gateway hybrid + deploy worker pool (default)
# false = daemon saja (mode native, tanpa Cloudflare)
HYBRID_ENABLED=true


# ============================================================================
# GATEWAY HYBRID DI VPS — listener & TLS
# ============================================================================
# Port dengar gateway (TLS). Di bawah mode speedtest-bridge (default, lihat
# bagian berikutnya) gateway hanya LOKAL: traffic publiknya datang lewat
# mux di port bridge (:8080), jadi :8790 TIDAK perlu publik.
# 8790 = nilai produksi saat ini. Listener PLAIN loopback tambahan untuk
# pipe HTTP dari bridge: HYBRID_GATEWAY_PLAIN_PORT (default 8791).
HYBRID_GATEWAY_PORT=8790
# Di bawah speedtest-bridge + TLS mux (default): install.sh MEMAKSA
# 127.0.0.1 — gateway tidak lagi terbuka ke publik; nilai .env ini diabaikan
# (tujuan proyek: hanya port native OoklaServer 8080+5060 yang terbuka).
HYBRID_GATEWAY_BIND=0.0.0.0

# TLS gateway (baca-saja; pakai sertifikat wildcard daemon yang sudah ada).
# Path contoh produksi (sertifikat ACME speedtestserver):
HYBRID_GATEWAY_TLS_CERT=/var/lib/speedtestserver/certs/fullchain.pem
HYBRID_GATEWAY_TLS_KEY=/var/lib/speedtestserver/certs/privkey.pem
# Kosongkan KEDUANYA untuk HTTP polos (hanya untuk lab, bukan produksi).

# URL publik (dipakai di dokumen discovery /api/servers):
# Di bawah speedtest-bridge + TLS mux: host diambil dari nilai ini, port
# DIGANTI otomatis ke port bridge (https://<host>:8080).
HYBRID_VPS_PUBLIC_BASE=https://speedtest.lumajangnetworks.my.id:8790
# Base fallback WS-NetGauge (permukaan daemon): port DIGANTI otomatis ke port
# daemon (https://<host>:5060) di bawah mode bridge.
HYBRID_STS_BASE=https://speedtest.lumajangnetworks.my.id:8080
# Base URL worker utama — dikosongkan → install.sh menurunkannya otomatis
# dari CF_WORKER_NAME + CF_WORKERS_SUBDOMAIN:
#   https://speedtest-hybrid-worker.lumajangnetworks.workers.dev
HYBRID_WORKER_BASE=


# ============================================================================
# SPEEDTEST-BRIDGE — front permanen VPS untuk klien NATIVE Ookla (:8080)
# ============================================================================
# Komponen SISI VPS (bukan klien!): klien selalu aplikasi ASLI Ookla tanpa
# modifikasi — CLI resmi hari ini, app Android/iOS, atau web. Bridge
# men-terminasi protokol NetGauge tepat seperti daemon (kontrol + identitas
# + loss tetap di VPS) sementara payload pengukuran di-origin-kan Worker CF
# (label jujur: edge-origin dengan relay VPS — tidak menambah kapasitas
# per sesi). Dipasang sebagai speedtest-bridge.service: auto-start saat
# boot + auto-restart saat crash (operator request 27 Nov).
#
# PENYATUAN PORT (hanya port native OoklaServer yang terbuka):
#   TCP+UDP :8080 → speedtest-bridge (mux daemon-parity, PROTOCOL_CONTRACT §1:
#               ClientHello 0x16 0x03… → TLS DITERMINASI DI BRIDGE dan NetGauge
#               native dilayani DI DALAM TLS = jalur UTAMA klien resmi; metode
#               HTTP (plain maupun di dalam TLS) → pipe ke listener plain
#               loopback gateway; lainnya → front NetGauge plaintext)
#   TCP+UDP :5060 → daemon OoklaServer (dikonfigurasi di
#               OoklaServer.properties — file config resminya, DENGAN backup
#               bertanda-waktu saat install.sh menyempitkannya)
#   :8790       → gateway TLS, LOOPBACK SAJA (tidak lagi publik)
#   :8791       → gateway plain-HTTP, LOOPBACK SAJA (upstream pipe bridge)
#
# Semua kunci di bawah ber-default aman — biarkan apa adanya kecuali ada
# alasan. Perubahan nilai berlaku via `systemctl restart speedtest-bridge`
# atau jalankan ulang install.sh (TIDAK di-watch on-the-fly seperti gateway).

# Aktifkan mode permanen (true/false). false = unit dilepas + daemon
# dikembalikan ke KEDUA port native (5060,8080) dari backup.
SPEEDTEST_BRIDGE_ENABLED=true

# Port bridge = port native utama OoklaServer. CLI resmi menarget :8080
# (semua server ter-publish memakai itu) — jangan ubah tanpa alasan.
SPEEDTEST_BRIDGE_PORT=8080

# Backend payload pengukuran:
#   worker-http (default, direkomendasikan) — /__down + /__up per-chunk
#   worker-ws   — sesi WSS NetGauge per koneksi (framing di-strip)
#   local       — pool paritas daemon murni VPS (kontrol A/B)
SPEEDTEST_BRIDGE_BACKEND=worker-http

# Port daemon setelah penyatuan: daftar native minus port bridge.
# Default otomatis: 5060. Ditulis KE OoklaServer.properties oleh install.sh.
# SPEEDTEST_BRIDGE_DAEMON_PORTS=5060

# Mux TLS di port bridge (paritas daemon, PROTOCOL_CONTRACT §1): TLS
# diterminasi DI BRIDGE (sertifikat wildcard daemon via systemd
# LoadCredential — diatur otomatis install.sh) sehingga klien resmi yang
# membuka NetGauge DI DALAM TLS tetap dilayani front; permintaan HTTP
# (plain maupun dalam TLS) di-pipe ke listener plain loopback gateway
# (HYBRID_GATEWAY_PLAIN_PORT). Tanpa sertifikat (lab): TLS di-proxy mentah
# ke gateway loopback (SPEEDTEST_BRIDGE_TLS_UPSTREAM).
# 1 = nyala (default, tujuan proyek), 0 = gateway tetap publik di portnya.
SPEEDTEST_BRIDGE_TLS_MUX=1
# SPEEDTEST_BRIDGE_TLS_UPSTREAM=127.0.0.1:8790   # mode lab (tanpa cert)
# SPEEDTEST_BRIDGE_HTTP_UPSTREAM=127.0.0.1:8791   # listener plain gateway

# --- guard abuse (rekomendasi laporan 27 Nov) ---
# Koneksi baru per menit per IP (satu run CLI membuka 30-45 koneksi →
# default 240 memuat ~5 run paralel per IP; 0 = mati).
SPEEDTEST_BRIDGE_CONN_RATE_PER_MIN=240
# Koneksi konkuren per IP (paritas daemon maxConnPerIp).
# SPEEDTEST_BRIDGE_MAX_CONN_PER_IP=500

# --- knob lanjutan (biarkan default kecuali tahu alasannya) ---
# SPEEDTEST_BRIDGE_HTTP_CHUNK=4194304
# SPEEDTEST_BRIDGE_UL_CHUNK=4194304
# SPEEDTEST_BRIDGE_WS_CHUNK=1048576
# SPEEDTEST_BRIDGE_TLS_SNIFF_MS=2000
# SPEEDTEST_BRIDGE_IDLE_MS=3600000
# SPEEDTEST_BRIDGE_MAX_DL_BYTES=134217728
# SPEEDTEST_BRIDGE_MAX_UL_BYTES=134217728
# SPEEDTEST_BRIDGE_TOKEN=            # token tetap (lewati mint; lab saja)
# SPEEDTEST_BRIDGE_WORKER_BASE=      # worker base tetap (lab saja)
# SPEEDTEST_BRIDGE_VERSION_STRING=2.11 (2.11.5) 2026-06-04.1737.7d0993d

# ============================================================================
# VPS ASSIST LANE v1.4 — "VPS mengeluarkan SEMUA potensi, CF membantu"
# ============================================================================
# Pangsa permintaan download yang dilayani VPS LANGSUNG pada kecepatan
# PENUH (TANPA budget, TANPA throttle — HYBRID_VPS_DL_BUDGET_MBPS sudah
# DIHAPUS per keputusan operator). Sisanya dibantu worker pool CF secara
# paralel. Interleave Bresenham per-IP (deterministik, benar sejak
# request pertama). Rentang 0.0..1.0:
#   1.0  = 100% VPS — potensi penuh, edge idle, kuota CF dihemat
#   0.0  = 100% edge (perilaku offload lama v1.2)
#   ≈ kapasitas_VPS / demand_klien → agregat maksimum
#   (contoh: VPS ~500 Mbps, klien 1 Gbps → 0.5; VPS 100 Mbps → 0.1-0.2)
HYBRID_VPS_DL_SHARE=0.15

# --- speedtest front (permukaan HTTP legacy di gateway) ---
HYBRID_FRONT_ENABLED=true
# Limit MINT token per IP per menit (yang cache-hit tidak dihitung).
HYBRID_FRONT_RATE_LIMIT_MPM=90
# Cap byte per redirect download; HARUS <= MAX_DOWNLOAD_BYTES worker (25 MiB).
HYBRID_FRONT_MAX_DOWN_BYTES=26214400
# Cache token per-IP (ms). Default = TTL-60s. 0 = matikan.
# HYBRID_FRONT_TOKEN_CACHE_MS=240000


# ============================================================================
# SMART WORKER POOL — kendali di VPS (batas aktif & autoscaler)
# ============================================================================
# Ukuran pool yang DIROTASI gateway (1..100). Kosong → = CF_WORKER_DEPLOY_COUNT.
# HYBRID_WORKER_POOL_MAX=100
# Worker aktif minimum/maksimum (autoscaler menumbuhkan sesuai mint-rate,
# canary-gated; mengecil setelah idle).
# HYBRID_WORKER_ACTIVE_MIN=2
# HYBRID_WORKER_ACTIVE_MAX=100
# tokens/menit per worker aktif yang mengjustifikasi +1 worker (scale-up).
# HYBRID_WORKER_SCALE_RATE=24
# HYBRID_WORKER_SHRINK_RATE=6
# HYBRID_WORKER_IDLE_SHRINK_MS=600000
# Probe berkala set aktif (0 = off; canary saat scale-up selalu aktif).
# HYBRID_WORKER_PROBE_INTERVAL_MS=0
# HYBRID_WORKER_BENCH_COOLDOWN_MS=120000
# Daftar URL worker eksplisit (wajib hanya bila base BUKAN *.workers.dev):
# HYBRID_WORKER_URLS=

# --- Quota guard akun CF (opsional; aktif otomatis bila token+account
#     terisi — install.sh menyalinnya sebagai HYBRID_CF_API_TOKEN) ---
# Query GraphQL 1x/jam: pemakaian harian vs kuota 100k (per akun).
# soft% → stop pertumbuhan pool; hard% → tolak mint token.
# HYBRID_CF_QUOTA_SOFT_PCT=80
# HYBRID_CF_QUOTA_HARD_PCT=95
# HYBRID_CF_DAILY_QUOTA=100000

# Rate-limit per-IP endpoint /api/sessions (anti token-fountain):
HYBRID_SESSIONS_RATE_LIMIT_MPM=60


# ============================================================================
# SYNC ON-THE-FLY + AUTO-UPDATE (v1.5)
# ============================================================================
# Semua kunci di atas terbaca ulang oleh gateway secara live (poll ~2 dtk).
# Alat kendali (di VPS):
#   curl -sk https://127.0.0.1:8790/api/workers   → status sinkronisasi pool
#   curl -sk https://127.0.0.1:8790/api/health    → mode (hybrid/vps-only)
#   journalctl -u speedtest-hybrid-gateway -f     → event env_change_applied,
#                                                  worker_sync_*
# Hapus worker berlebih saat mengecilkan target (default true; false =
# hanya deploy, tidak pernah menghapus):
# HYBRID_WORKER_SYNC_DELETE=true
# Re-verifikasi berkala pool (0 = hanya saat .env berubah):
# HYBRID_WORKER_SYNC_INTERVAL_MS=0
# Auto-update harian (04:30 + jitter) — cabang yang diikuti:
# AUTO_UPDATE_BRANCH=master

# --- token sesi ---
HYBRID_TOKEN_TTL_MS=300000
HYBRID_TOKEN_BIND_IP=false

# --- hasil ukur (JSONL) ---
HYBRID_RESULTS_FILE=/var/lib/speedtest-hybrid/results.jsonl
HYBRID_RESULTS_DEDUP_MS=3600000


# ============================================================================
# CLIENT HYBRID (di mesin klien — BUKAN dipakai install.sh; dokumentasi)
# ============================================================================
# Wrapper klien: hybrid/probe-client/speedtest-cli-hybrid.py
#   HYBRID_GATEWAY_BASE / HYBRID_FRONT_BASE / HYBRID_WORKER_BASE  = URL di atas
#   HYBRID_DL_THREADS=16 HYBRID_UL_THREADS=8 HYBRID_DL_COUNTS=8   = paralelisme
#   HYBRID_VPS_UL_SHARE=0.15 = porsi upload POST yang tetap di VPS
#     (ingress VPS penuh tanpa cap; sisanya ke worker __up — Bresenham)
# Contoh menjalankan klien:
#   HYBRID_GATEWAY_BASE=https://speedtest.lumajangnetworks.my.id:8790 \
#   HYBRID_WORKER_BASE=https://speedtest-hybrid-worker.lumajangnetworks.workers.dev \
#   HYBRID_FRONT_BASE=https://speedtest.lumajangnetworks.my.id:8790 \
#   HYBRID_SERVER_LIST_FILE=hybrid/probe-client/server-list-surabaya.json \
#   HYBRID_DL_THREADS=16 HYBRID_UL_THREADS=8 HYBRID_VPS_UL_SHARE=0.15 \
#   python3 hybrid/probe-client/speedtest-cli-hybrid.py --json --server <ID>
#
# CLI RESMI Ookla: TIDAK butuh variabel apa pun — klien native (CLI/app/web)
# bicara NetGauge TCP+UDP langsung ke speedtest-bridge :8080 (mode permanen,
# payload dari pool Worker; label jujur: edge-origin via relay VPS). Metode
# uji lengkap + mock hosts: docs/OFFICIAL_CLI_TESTING_GUIDE.md; kontrak
# proyek: CONTRACT.md.
