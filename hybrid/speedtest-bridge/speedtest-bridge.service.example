# speedtest-bridge.service — the permanent speedtest-bridge unit.
#
# Generated/installed by the installer core (this example shows the production
# shape; the core writes the real unit with resolved paths). PORT AUTHORITY:
# the bridge owns EVERY port listed in OoklaServer.properties
# (SPEEDTEST_BRIDGE_PORTS / SPEEDTEST_BRIDGE_UDP_PORTS are derived from
# OoklaServer.tcpPorts / udpPorts — port 8080 mandatory; no port assumption):
#   - native NetGauge front for unmodified official Ookla clients
#     (CLI / mobile apps), measurement payload from the Worker pool;
#   - TLS is TERMINATED ON THE BRIDGE on every TCP port (daemon parity —
#     NetGauge inside TLS = the official client's primary path) and HTTP
#     methods pipe to the gateway over its Unix socket — the gateway has NO
#     TCP port at all.
# The OoklaServer daemon unit is parked while the bridge owns the ports
# (SPEEDTEST_BRIDGE_ENABLED=false re-enables it on ALL properties ports).
#
# Auto-start on boot + auto-restart on crash are the whole point of this
# unit (operator request, 27 Nov 2026): Restart=always + RestartSec=3,
# enabled via WantedBy=multi-user.target.

[Unit]
Description=Speedtest Bridge (VPS front for native Ookla clients: NetGauge parity + Worker payload, ports from OoklaServer.properties)
Documentation=file:///opt/speedtest-hybrid/speedtest-bridge/README.md
# Start order: the gateway mints the worker tokens the bridge relays (the
# bridge tolerates a late gateway: cached token + 5s mint backoff). Requires
# = start propagation only — the native front deliberately SURVIVES a brief
# gateway restart.
After=network-online.target speedtest-hybrid-gateway.service
Wants=network-online.target
Requires=speedtest-hybrid-gateway.service
# Restart rate-limiting (unit-level keys since systemd 230)
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=speedtest-hybrid
Group=speedtest-hybrid
EnvironmentFile=/etc/speedtest-hybrid/speedtest-bridge.env
WorkingDirectory=/opt/speedtest-hybrid
ExecStart=/usr/bin/node /opt/speedtest-hybrid/speedtest-bridge/speedtest-bridge.mjs
# auto-start after reboot AND auto-restart after any crash/exit
Restart=always
RestartSec=3
# Hardening (same profile as the gateway unit; no capabilities needed — the
# OoklaServer.properties ports are unprivileged ports)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/speedtest-bridge
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
