[Unit]
Description=Speedtest Hybrid Gateway (VPS control plane + assist lane — Unix socket, NO TCP port)
Documentation=file:/opt/speedtest-hybrid/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=speedtest-hybrid
Group=speedtest-hybrid
# Environment file holds HYBRID_SHARED_SECRET (0640 root:speedtest-hybrid).
# Generated by the installer core from the repository .env — the single
# source of truth for install-time configuration (worker deploy count,
# CF creds). PORT AUTHORITY: gateway.env sets HYBRID_GATEWAY_SOCKET (no
# HYBRID_GATEWAY_PORT/BIND — the only TCP/UDP ports of the project are the
# OoklaServer.properties ports, owned by the speedtest-bridge front; the
# bridge mints + pipes over this socket).
EnvironmentFile=/etc/speedtest-hybrid/gateway.env
WorkingDirectory=/opt/speedtest-hybrid
ExecStart=/usr/bin/node /opt/speedtest-hybrid/gateway/src/gateway.mjs
Restart=on-failure
RestartSec=2
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# /run stays writable under ProtectSystem=strict; RuntimeDirectory pre-creates
# /run/speedtest-hybrid owned by the service user for the gateway socket.
RuntimeDirectory=speedtest-hybrid
ReadWritePaths=/var/lib/speedtest-hybrid
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

# The gateway socket: /run/speedtest-hybrid/gateway.sock (mode 0660).
# Admin access from the VPS:
#   curl --unix-socket /run/speedtest-hybrid/gateway.sock http://localhost/api/health
#   curl --unix-socket /run/speedtest-hybrid/gateway.sock http://localhost/api/pool
# The bridge reaches the same socket for token minting and the HTTP lane
# (SPEEDTEST_BRIDGE_GATEWAY_BASE / SPEEDTEST_BRIDGE_HTTP_UPSTREAM).
