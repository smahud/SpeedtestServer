[Unit]
Description=Speedtest Hybrid Gateway (VPS control plane + full-potential assist lane v1.4)
Documentation=file:/opt/speedtest-hybrid/README.md
After=network-online.target speedtestserver.service
Wants=network-online.target

[Service]
Type=simple
User=speedtest-hybrid
Group=speedtest-hybrid
# Environment file holds HYBRID_SHARED_SECRET (0640 root:speedtest-hybrid).
# Generated by install.sh from the repository .env — the single source of
# truth for install-time configuration (worker deploy count, CF creds).
EnvironmentFile=/etc/speedtest-hybrid/gateway.env
WorkingDirectory=/opt/speedtest-hybrid
ExecStart=/usr/bin/node /opt/speedtest-hybrid/src/gateway.mjs
Restart=on-failure
RestartSec=2
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/speedtest-hybrid
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
# v1.5: when TLS is configured, install.sh emits a unit with:
#   LoadCredential=cert:/var/lib/speedtestserver/certs/fullchain.pem
#   LoadCredential=key:/var/lib/speedtestserver/certs/privkey.pem
# and gateway.env points at /run/credentials/speedtest-hybrid-gateway.service/{cert,key}
# (the unprivileged service user never touches the 0600 privkey directly).
