# /etc/speedtest-hybrid/gateway.env — template TANPA SECRET.
# Salin ke /etc/speedtest-hybrid/gateway.env, isi HYBRID_SHARED_SECRET, chown
# root:speedtest-hybrid, chmod 0600. Jangan pernah commit versi berisi secret.

# --- wajib ---
HYBRID_SHARED_SECRET=<isi-dengan-secret-yang-sama-dengan-Worker>

# --- listener (PORT AUTHORITY: produksi = UNIX SOCKET, TANPA port TCP —
#     port TCP/UDP satu-satunya milik OoklaServer.properties, dipegang
#     speedtest-bridge; HYBRID_GATEWAY_PORT/BIND hanya untuk lab/test) ---
HYBRID_GATEWAY_SOCKET=/run/speedtest-hybrid/gateway.sock
# HYBRID_GATEWAY_PORT=8790            # lab/test only (ignored when SOCKET set)
# HYBRID_GATEWAY_BIND=127.0.0.1       # lab/test only (ignored when SOCKET set)
# TLS tidak dipakai di mode socket (izin akses = izin file system; socket
# dibuat 0660). Sertifikat justru dipakai BRIDGE untuk terminasi TLS di
# port-port properties:
# HYBRID_GATEWAY_TLS_CERT=/var/lib/speedtestserver/certs/fullchain.pem
# HYBRID_GATEWAY_TLS_KEY=/var/lib/speedtestserver/certs/privkey.pem

# --- URL publik ---
HYBRID_VPS_PUBLIC_BASE=https://speedtest.lumajangnetworks.my.id:8080
HYBRID_WORKER_BASE=https://speedtest-hybrid-worker.<subdomain>.workers.dev
HYBRID_STS_BASE=https://speedtest.lumajangnetworks.my.id:8080

# --- token (G-1) ---
HYBRID_TOKEN_TTL_MS=300000
HYBRID_TOKEN_BIND_IP=false

# --- discovery (G-3/K-7) ---
HYBRID_DISCOVERY_FALLBACK=false

# --- hasil (G-9) ---
HYBRID_RESULTS_FILE=/var/lib/speedtest-hybrid/results.jsonl
HYBRID_RESULTS_DEDUP_MS=3600000

# --- speedtest front (sesi 3; default kode false) ---
# Permukaan HTTP legacy speedtest dengan offload payload ke Worker.
# Lihat docs/SPEEDTEST_FRONT_TEST_REPORT_2026-11-24.md dan
# docs/HYBRID_DEPLOYMENT_RUNBOOK.md bagian front.
HYBRID_FRONT_ENABLED=true
# Mint token per IP per menit (0 = tanpa limit; jangan untuk produksi)
HYBRID_FRONT_RATE_LIMIT_MPM=90
# Cap byte per redirect download; HARUS <= MAX_DOWNLOAD_BYTES Worker
HYBRID_FRONT_MAX_DOWN_BYTES=26214400
# Cache token offload per-IP (ms; 0 = matikan). Default = TTL - 60s. v1.3:
# download ramp multi-thread tidak lagi mint token per request.
# HYBRID_FRONT_TOKEN_CACHE_MS=240000

# --- VPS assist lane (v1.4 — "VPS mengeluarkan SEMUA potensi, CF membantu") ---
# Pangsa (share) PERMINTAAN download yang dilayani LANGSUNG oleh VPS pada
# KECEPATAN PENUH — TANPA budget, TANPA throttle (HYBRID_VPS_DL_BUDGET_MBPS
# DIHAPUS di v1.4 atas keputusan operator: VPS tidak boleh dibatasi).
# Sisanya (1 - share) dibantu 302 oleh pool worker CF secara PARALEL,
# agregat ≈ kapasitas VPS + kapasitas edge.
#   1.0 = 100% VPS (potensi penuh; edge idle, kuota CF dihemat)
#   0.0 = 100% edge (perilaku lama v1.2)
#   ~ kapasitas_VPS / demand_klien untuk agregat maksimum
# (default kode 0.15 bila kosong; "0" dihormati sebagai nol eksplisit)
HYBRID_VPS_DL_SHARE=0.15

# --- Smart worker pool (sesi 8, 2026-11-25; default = perilaku lama 1 worker) ---
# Ukuran pool di rotasi (1..100 — batas script akun Free). Set bersama worker siblings.
# HYBRID_WORKER_POOL_MAX=100
# Worker aktif minimum/maksimum; autoscaler menumbuhkan sesuai mint-rate.
# HYBRID_WORKER_ACTIVE_MIN=2
# HYBRID_WORKER_ACTIVE_MAX=100
# tokens/min per worker aktif yang mengjustifikasi penambahan worker (scale-up
# canary-gated; canary gagal → backoff 5s..60s + bench).
# HYBRID_WORKER_SCALE_RATE=24
# HYBRID_WORKER_SHRINK_RATE=6
# HYBRID_WORKER_IDLE_SHRINK_MS=600000
# Probe berkala set aktif (0 = off — canary saat scale-up selalu aktif).
# HYBRID_WORKER_PROBE_INTERVAL_MS=0
# HYBRID_WORKER_BENCH_COOLDOWN_MS=120000
# Daftar URL worker eksplisit (wajib bila base bukan *.workers.dev):
# HYBRID_WORKER_URLS=
# Quota guard akun (opsional; query GraphQL 1x/jam; soft=stop-grow, hard=tolak-mint):
# HYBRID_CF_API_TOKEN=
# HYBRID_CF_ACCOUNT_ID=
# HYBRID_CF_QUOTA_SOFT_PCT=80
# HYBRID_CF_QUOTA_HARD_PCT=95
# Rate-limit per-IP /api/sessions (fix token-fountain):
# HYBRID_SESSIONS_RATE_LIMIT_MPM=60

# --- v1.5: on-the-fly .env sync (managed by the installer core) ---
# HYBRID_ENV_FILE=/opt/SpeedtestServer-src/.env
# HYBRID_ENV_POLL_MS=2000
# HYBRID_WORKER_BUNDLE=/opt/speedtest-hybrid/worker/dist/worker-bundle.js
# HYBRID_WORKER_FP_FILE=/var/lib/speedtest-hybrid/deployed.pool.sha
# HYBRID_VERSION_FILE=/opt/SpeedtestServer-src/VERSION
# HYBRID_WORKER_SYNC_DELETE=true
# HYBRID_WORKER_SYNC_INTERVAL_MS=0
# CF_WORKER_DEPLOY_COUNT=100
# CF_WORKER_NAME=speedtest-hybrid-worker
# CF_WORKERS_SUBDOMAIN=lumajangnetworks
# Cloudflare credentials for the on-the-fly deploy sync (token method):
# HYBRID_CF_API_TOKEN=...
# HYBRID_CF_ACCOUNT_ID=...
# ...or global key method:
# HYBRID_CF_EMAIL=...
# HYBRID_CF_API_KEY=...
